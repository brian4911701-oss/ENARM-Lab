rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isVerifiedSelf(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function validPublicUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 20
        && value.matches('^[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ _.-]+$');
    }

    function optionalString(data, field, maxSize) {
      return !data.keys().hasAll([field])
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function validPublicProfile(data, uid) {
      return data.keys().hasAll(["uid", "username", "specialty", "avatarId", "scoreVisible", "score", "isPremium", "flame", "updatedAt"])
        && data.keys().hasOnly(["uid", "username", "specialty", "avatarId", "scoreVisible", "score", "isPremium", "flame", "updatedAt"])
        && data.uid == uid
        && validPublicUsername(data.username)
        && data.specialty is string && data.specialty.size() <= 80
        && data.avatarId is string && data.avatarId.size() <= 60
        && data.scoreVisible is bool
        && ((data.scoreVisible == false && data.score == null)
          || (data.scoreVisible == true && data.score is number && data.score >= 0 && data.score <= 100))
        && data.isPremium is bool
        && data.flame is int && data.flame >= 0 && data.flame <= 100000
        && data.updatedAt == request.time;
    }

    function hasActiveEntitlement(uid) {
      let path = /databases/$(database)/documents/entitlements/$(uid);
      let entitlement = getAfter(path);
      return existsAfter(path)
        && entitlement.data.status == "active"
        && (!entitlement.data.keys().hasAll(["expiresAt"]) || entitlement.data.expiresAt > request.time);
    }

    function validReferralCode(code) {
      return code is string && code.matches('^EL[A-Z0-9]{6,12}$');
    }

    function validUserMetricCounters(counters) {
      return counters is map
        && counters.keys().hasAll(["sessions", "answered", "correct", "studySeconds", "pomodoros", "simulations"])
        && counters.keys().hasOnly(["sessions", "answered", "correct", "studySeconds", "pomodoros", "simulations"])
        && counters.sessions is int && counters.sessions >= 0
        && counters.answered is int && counters.answered >= 0
        && counters.correct is int && counters.correct >= 0 && counters.correct <= counters.answered
        && counters.studySeconds is int && counters.studySeconds >= 0
        && counters.pomodoros is int && counters.pomodoros >= 0
        && counters.simulations is int && counters.simulations >= 0;
    }

    function validSpecialtyMetric(row) {
      return row is map
        && row.keys().hasAll(["answered", "correct"])
        && row.keys().hasOnly(["answered", "correct"])
        && row.answered is int && row.answered >= 0
        && row.correct is int && row.correct >= 0 && row.correct <= row.answered;
    }

    function validUserMetrics(data, uid) {
      return data.uid == uid
        && data.schemaVersion == 1
        && data.lastActivityDay is string
        && data.lastActivityDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.activityDays is list && data.activityDays.size() <= 400
        && data.daily is list && data.daily.size() <= 400
        && data.bySpecialty is map
        && data.bySpecialty.keys().hasAll(["mi", "ped", "gyo", "cir"])
        && data.bySpecialty.keys().hasOnly(["mi", "ped", "gyo", "cir"])
        && validSpecialtyMetric(data.bySpecialty.mi)
        && validSpecialtyMetric(data.bySpecialty.ped)
        && validSpecialtyMetric(data.bySpecialty.gyo)
        && validSpecialtyMetric(data.bySpecialty.cir)
        && validUserMetricCounters(data.cumulative)
        && data.features is map
        && data.features.keys().hasOnly(["exams", "studyPlus", "pomodoro", "flashcards", "scales", "community", "referrals"])
        && data.health is map
        && data.health.keys().hasAll(["jsErrors", "pageLoads", "lastPageLoadMs", "lastJsErrorDay"])
        && data.health.keys().hasOnly(["jsErrors", "pageLoads", "lastPageLoadMs", "lastJsErrorDay"])
        && data.health.jsErrors is int && data.health.jsErrors >= 0
        && data.health.pageLoads is int && data.health.pageLoads >= 0
        && data.health.lastPageLoadMs is int && data.health.lastPageLoadMs >= 0
        && data.health.lastJsErrorDay is string
        && (data.health.lastJsErrorDay == "" || data.health.lastJsErrorDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.historyApproximate is bool
        && data.lastActiveAt == request.time
        && data.updatedAt == request.time;
    }

    function hasReferralRedemptionAfter(ownerUid) {
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid)).data.ownerUid == ownerUid
        && getAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid)).data.coins == 50;
    }

    function isReferralRewardUpdate(ownerUid) {
      return isVerified()
        && request.auth.uid != ownerUid
        && hasReferralRedemptionAfter(ownerUid)
        && request.resource.data.uid == ownerUid
        && request.resource.data.lastReferralUid == request.auth.uid
        && request.resource.data.referralCode == resource.data.referralCode
        && request.resource.data.coins == resource.data.coins + 50
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastReferralRewardAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "coins", "updatedAt", "lastReferralRewardAt", "lastReferralUid", "lastReferralCode"
        ]);
    }

    function isReferralRewardCreate(ownerUid) {
      return isVerified()
        && request.auth.uid != ownerUid
        && hasReferralRedemptionAfter(ownerUid)
        && request.resource.data.uid == ownerUid
        && request.resource.data.lastReferralUid == request.auth.uid
        && request.resource.data.coins == 50
        && request.resource.data.referralCode == getAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid)).data.referralCode
        && request.resource.data.lastReferralCode == request.resource.data.referralCode
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastReferralRewardAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid", "referralCode", "coins", "createdAt", "updatedAt",
          "lastReferralRewardAt", "lastReferralUid", "lastReferralCode"
        ]);
    }

    function isPremiumTrialEntitlement(uid) {
      let trial = getAfter(/databases/$(database)/documents/premium_trials/$(uid));
      return isSelf(uid)
        && trial.data.uid == uid
        && trial.data.status == "used"
        && trial.data.durationDays == 3
        && trial.data.startedAt == request.time
        && request.resource.data.status == "active"
        && request.resource.data.source == "premium_trial"
        && request.resource.data.planId == "premium_trial_3d"
        && request.resource.data.activatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt == trial.data.expiresAt
        && request.resource.data.keys().hasOnly(["status", "source", "planId", "activatedAt", "expiresAt", "updatedAt"]);
    }

    function validChallengeResultUpdate(previous, next) {
      return previous is map
        && next is map
        && next.keys().hasOnly(["name", "isPremium", "score", "status", "timestamp"])
        && ((next.name == previous.name && next.isPremium == previous.isPremium)
          || (next.name == "Cuenta eliminada" && next.isPremium == false && next.score == null && next.status == "dismissed"))
        && next.status in ["pending", "completed", "dismissed"]
        && ((next.status == "pending" && next.score == null && next.timestamp == null)
          || (next.status == "completed" && next.score is number && next.score >= 0 && next.score <= 100 && next.timestamp is timestamp)
          || (next.status == "dismissed" && next.score == null && next.timestamp is timestamp));
    }

    function canReplaceExpiredEntitlementWithTrial() {
      return !resource.data.keys().hasAll(["expiresAt"])
        || resource.data.status != "active"
        || resource.data.expiresAt <= request.time;
    }

    match /redeem_codes/{code} {
      // Los códigos son secretos de alta entropía: nunca se pueden listar.
      allow get: if isVerified() && code.matches('^ENARM-(D3|M1|FX)-[A-Z2-9]{26}$');
      allow list: if false;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isVerified()
        && code.matches('^ENARM-(D3|M1|FX)-[A-Z2-9]{26}$')
        && resource.data.redeemedBy == ""
        && (!resource.data.keys().hasAll(["disabled"]) || resource.data.disabled == false)
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["redeemedBy", "redeemedAt"]));
    }

    match /entitlements/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin()
        || (isVerifiedSelf(uid)
        && request.resource.data.source == "code"
        && request.resource.data.keys().hasOnly(["status", "source", "planId", "activatedAt", "expiresAt", "updatedAt", "code"])
        && request.resource.data.status == "active"
        && request.resource.data.activatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.redeemedBy == uid
        && request.resource.data.planId == "premium_code_" + getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type
        && request.resource.data.expiresAt > request.time
        && ((getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type == "three_day"
              && request.resource.data.expiresAt <= request.time + duration.value(3, "d") + duration.value(10, "m"))
          || (getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type == "month"
              && request.resource.data.expiresAt <= request.time + duration.value(30, "d") + duration.value(10, "m"))
          || (getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type == "fixed"
              && request.resource.data.expiresAt <= timestamp.date(2026, 10, 2))))
        || isPremiumTrialEntitlement(uid);
      allow update: if isAdmin()
        || (isVerifiedSelf(uid)
        && request.resource.data.source == "code"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "source", "planId", "activatedAt", "expiresAt", "updatedAt", "code"])
        && request.resource.data.status == "active"
        && request.resource.data.activatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.redeemedBy == uid
        && request.resource.data.planId == "premium_code_" + getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type
        && request.resource.data.expiresAt > request.time
        && ((getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type == "three_day"
              && request.resource.data.expiresAt <= request.time + duration.value(3, "d") + duration.value(10, "m"))
          || (getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type == "month"
              && request.resource.data.expiresAt <= request.time + duration.value(30, "d") + duration.value(10, "m"))
          || (getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.type == "fixed"
              && request.resource.data.expiresAt <= timestamp.date(2026, 10, 2))))
        || (isPremiumTrialEntitlement(uid) && canReplaceExpiredEntitlementWithTrial());
      allow delete: if isAdmin();
    }

    match /payment_profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isVerifiedSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.transferReference is string
        && request.resource.data.keys().hasOnly(["uid", "email", "transferReference", "createdAt", "updatedAt"])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.transferReference.matches('^[0-9]{10}$')
        && existsAfter(/databases/$(database)/documents/transfer_references/$(request.resource.data.transferReference))
        && getAfter(/databases/$(database)/documents/transfer_references/$(request.resource.data.transferReference)).data.uid == uid;
      allow update, delete: if false;
    }

    match /transfer_references/{reference} {
      allow get: if isVerified();
      allow list: if isAdmin();
      allow create: if isVerified()
        && reference.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(["uid", "transferReference", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.transferReference == reference
        && request.resource.data.createdAt is timestamp
        && existsAfter(/databases/$(database)/documents/payment_profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/payment_profiles/$(request.auth.uid)).data.transferReference == reference;
      allow update, delete: if false;
    }

    match /manual_payment_requests/{requestId} {
      allow read: if isAdmin()
        || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly([
          "uid", "email", "planId", "amount", "seats", "squadMembers", "currency",
          "transferReference", "referralCode", "termsAccepted", "status", "createdAt", "notifiedAt", "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && request.resource.data.notifiedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status == "pending"
        && request.resource.data.currency == "MXN"
        && request.resource.data.termsAccepted == true
        && request.resource.data.referralCode is string
        && request.resource.data.seats is int
        && request.resource.data.squadMembers is list
        && request.resource.data.transferReference == get(/databases/$(database)/documents/payment_profiles/$(request.auth.uid)).data.transferReference
        && ((request.resource.data.planId == "enarm_2026" && request.resource.data.amount == 399 && request.resource.data.seats == 1 && request.resource.data.squadMembers.size() == 0)
          || (request.resource.data.planId == "enarm_2027" && request.resource.data.amount == 1999 && request.resource.data.seats == 1 && request.resource.data.squadMembers.size() == 0)
          || (request.resource.data.planId == "squad_2027" && request.resource.data.amount == 4999 && request.resource.data.seats == 4
            && request.resource.data.squadMembers.size() == 3
            && request.resource.data.squadMembers[0] is string && request.resource.data.squadMembers[0].size() > 0 && request.resource.data.squadMembers[0].size() <= 60
            && request.resource.data.squadMembers[1] is string && request.resource.data.squadMembers[1].size() > 0 && request.resource.data.squadMembers[1].size() <= 60
            && request.resource.data.squadMembers[2] is string && request.resource.data.squadMembers[2].size() > 0 && request.resource.data.squadMembers[2].size() <= 60));
      allow update: if isAdmin()
        || (isVerified()
          && resource.data.uid == request.auth.uid
          && resource.data.status in ["pending", "rejected"]
          && request.resource.data.status == "pending"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.planId == resource.data.planId
          && request.resource.data.amount == resource.data.amount
          && (
            (resource.data.keys().hasAll(["seats"]) && request.resource.data.seats == resource.data.seats)
            || (!resource.data.keys().hasAll(["seats"]) && request.resource.data.seats == 1)
          )
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.transferReference == resource.data.transferReference
          && request.resource.data.termsAccepted == true
          && request.resource.data.referralCode is string
          && request.resource.data.squadMembers is list
          && request.resource.data.keys().hasOnly([
            "uid", "email", "planId", "amount", "seats", "squadMembers", "currency",
            "transferReference", "referralCode", "termsAccepted", "status", "createdAt", "notifiedAt", "updatedAt"
          ])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.notifiedAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && ((request.resource.data.planId in ["enarm_2026", "enarm_2027"] && request.resource.data.squadMembers.size() == 0)
            || (request.resource.data.planId == "squad_2027" && request.resource.data.squadMembers.size() == 3
              && request.resource.data.squadMembers[0] is string && request.resource.data.squadMembers[0].size() > 0 && request.resource.data.squadMembers[0].size() <= 60
              && request.resource.data.squadMembers[1] is string && request.resource.data.squadMembers[1].size() > 0 && request.resource.data.squadMembers[1].size() <= 60
              && request.resource.data.squadMembers[2] is string && request.resource.data.squadMembers[2].size() > 0 && request.resource.data.squadMembers[2].size() <= 60)));
      allow delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      // Colección legada en cuarentena durante la migración.
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if false;
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /public_profiles/{uid} {
      allow read: if isVerified();
      allow create: if isVerifiedSelf(uid)
        && validPublicProfile(request.resource.data, uid)
        && (request.resource.data.isPremium == false || hasActiveEntitlement(uid));
      allow update: if isVerifiedSelf(uid)
        && validPublicProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "username", "specialty", "avatarId", "scoreVisible", "score", "isPremium", "flame", "updatedAt"
        ])
        && (request.resource.data.isPremium == false || hasActiveEntitlement(uid));
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /user_progress/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasAll(["uid", "schemaVersion", "createdAt", "updatedAt"])
        && request.resource.data.keys().hasOnly([
          "uid", "schemaVersion", "theme", "fontPreset", "appearanceStr", "dailyPlanStr",
          "reviewQueueStr", "topicMasteryStr", "caseNotebookStr", "studyCalendarStr",
          "lastPostmortemStr", "pomodoroSettingsStr", "pomodoroLogStr",
          "pomodoroSpecialtiesStr", "pomodoroFocusLabel", "globalStatsStr", "historyStr",
          "reportsStr", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "schemaVersion", "theme", "fontPreset", "appearanceStr", "dailyPlanStr",
          "reviewQueueStr", "topicMasteryStr", "caseNotebookStr", "studyCalendarStr",
          "lastPostmortemStr", "pomodoroSettingsStr", "pomodoroLogStr",
          "pomodoroSpecialtiesStr", "pomodoroFocusLabel", "globalStatsStr", "historyStr",
          "reportsStr", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Datos de contacto privados para el panel de administraci\u00f3n.
    // No se mezclan con leaderboard, que puede ser le\u00eddo por otros usuarios.
    match /user_directory/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.username is string
        && validPublicUsername(request.resource.data.username)
        && request.resource.data.emailVerified is bool
        && request.resource.data.university is string && request.resource.data.university.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 16
        && request.resource.data.targetYear is string && request.resource.data.targetYear.size() <= 4
        && request.resource.data.keys().hasOnly(["uid", "email", "emailVerified", "username", "university", "phone", "targetYear", "createdAt", "lastSeenAt"])
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.username is string
        && validPublicUsername(request.resource.data.username)
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.university is string && request.resource.data.university.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 16
        && request.resource.data.targetYear is string && request.resource.data.targetYear.size() <= 4
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["email", "emailVerified", "username", "university", "phone", "targetYear", "lastSeenAt"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSeenAt"])
          || request.resource.data.lastSeenAt == request.time);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Una prueba gratuita se crea junto con el entitlement en una transacción.
    // No se puede editar o volver a crear, aun desde un cliente manipulado.
    match /premium_trials/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasOnly(["uid", "status", "startedAt", "expiresAt", "durationDays"])
        && request.resource.data.uid == uid
        && request.resource.data.status == "used"
        && request.resource.data.durationDays == 3
        && request.resource.data.startedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, "d") + duration.value(10, "m");
      allow update, delete: if false;
    }

    // Métricas compactas y sin datos personales. El cliente solo mantiene su
    // propio documento; el administrador puede agregarlas en el panel interno.
    match /user_metrics/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasAll([
          "uid", "schemaVersion", "registeredAt", "trackingStartedAt", "lastActiveAt",
          "lastActivityDay", "activityDays", "cumulative", "bySpecialty", "features", "health",
          "daily", "historyApproximate", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "schemaVersion", "registeredAt", "trackingStartedAt", "lastActiveAt",
          "lastActivityDay", "activityDays", "cumulative", "bySpecialty", "features", "health",
          "daily", "historyApproximate", "updatedAt"
        ])
        && request.resource.data.registeredAt == request.time
        && request.resource.data.trackingStartedAt == request.time
        && validUserMetrics(request.resource.data, uid);
      allow update: if isVerifiedSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.registeredAt == resource.data.registeredAt
        && request.resource.data.trackingStartedAt == resource.data.trackingStartedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "schemaVersion", "lastActiveAt", "lastActivityDay", "activityDays", "cumulative",
          "bySpecialty", "features", "health", "daily", "historyApproximate", "updatedAt"
        ])
        && validUserMetrics(request.resource.data, uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /referral_codes/{code} {
      allow get: if isVerified();
      allow list: if false;
      allow create: if isVerified()
        && validReferralCode(code)
        && request.resource.data.code == code
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(["code", "ownerUid", "ownerName", "createdAt"]);
      allow update, delete: if isAdmin();
    }

    match /user_wallets/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if (isVerifiedSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.coins == 0
        && validReferralCode(request.resource.data.referralCode)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(["uid", "referralCode", "coins", "createdAt", "updatedAt"]))
        || isReferralRewardCreate(uid);
      allow update: if isAdmin() || isReferralRewardUpdate(uid);
      allow delete: if isAdmin();
    }

    match /referral_redemptions/{uid} {
      allow read: if isSelf(uid) || isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasOnly(["uid", "ownerUid", "referralCode", "premiumCode", "coins", "createdAt"])
        && request.resource.data.uid == uid
        && request.resource.data.coins == 50
        && validReferralCode(request.resource.data.referralCode)
        && request.resource.data.ownerUid != uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/referral_codes/$(request.resource.data.referralCode))
        && get(/databases/$(database)/documents/referral_codes/$(request.resource.data.referralCode)).data.ownerUid == request.resource.data.ownerUid
        && existsAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.premiumCode))
        && getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.premiumCode)).data.redeemedBy == uid;
      allow update, delete: if isAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if isVerified()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly(["fromId", "fromName", "fromPremium", "toId", "toName", "status", "timestamp"])
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && validPublicUsername(request.resource.data.fromName)
        && validPublicUsername(request.resource.data.toName)
        && request.resource.data.fromPremium is bool
        && request.resource.data.status == "pending"
        && request.resource.data.timestamp is timestamp;
      allow update: if isVerified()
        && resource.data.toId == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "rejected"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
      allow delete: if isAdmin() || (isVerified() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid));
    }

    match /challenges/{challengeId} {
      allow read: if isVerified() && request.auth.uid in resource.data.participantIds;
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly([
          "challengerId", "challengerName", "challengerPremium", "participants", "participantIds",
          "specialty", "numQuestions", "targetQty", "questionIndices", "status", "createdAt"
        ])
        && request.resource.data.challengerId == request.auth.uid
        && validPublicUsername(request.resource.data.challengerName)
        && request.resource.data.challengerPremium is bool
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 4
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participants is map
        && request.resource.data.specialty is string && request.resource.data.specialty.size() <= 100
        && request.resource.data.numQuestions is int && request.resource.data.numQuestions > 0 && request.resource.data.numQuestions <= 300
        && request.resource.data.targetQty == request.resource.data.numQuestions
        && request.resource.data.questionIndices is list && request.resource.data.questionIndices.size() == request.resource.data.numQuestions
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is int;
      allow update: if isVerified()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.uid])
        && validChallengeResultUpdate(resource.data.participants[request.auth.uid], request.resource.data.participants[request.auth.uid])
        && request.resource.data.status in ["active", "finished"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participants", "status"]);
      allow delete: if isAdmin() || (isVerified() && resource.data.challengerId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly([
          "timestamp", "questionText", "caseText", "specialty", "tema", "category", "reason",
          "caseKey", "userName", "userId", "status", "clientReportId"
        ])
        && request.resource.data.userId == request.auth.uid
        && validPublicUsername(request.resource.data.userName)
        && request.resource.data.timestamp is int
        && request.resource.data.questionText is string && request.resource.data.questionText.size() <= 2000
        && request.resource.data.caseText is string && request.resource.data.caseText.size() <= 6000
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 2000
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.status == "quarantine";
      allow update: if isVerified()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status == "quarantine"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reason", "category"])
        && request.resource.data.keys().hasOnly([
          "timestamp", "questionText", "caseText", "specialty", "tema", "category", "reason",
          "caseKey", "userName", "userId", "status", "clientReportId"
        ]);
      allow delete: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
    }

    match /user_push_tokens/{tokenId} {
      allow read: if false;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "token", "enabled", "platform", "userAgent", "updatedAt"])
        && request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096
        && request.resource.data.enabled == true
        && request.resource.data.platform in ["web", "ios-web", "android-web"]
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 512
        && request.resource.data.updatedAt is int;
      allow update: if isVerified()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["token", "enabled", "platform", "userAgent", "updatedAt"])
        && request.resource.data.keys().hasOnly(["uid", "token", "enabled", "platform", "userAgent", "updatedAt"])
        && request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096
        && request.resource.data.enabled == true
        && request.resource.data.platform in ["web", "ios-web", "android-web"]
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 512
        && request.resource.data.updatedAt is int;
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

    match /withdrawal_requests/{requestId} {
      allow read: if isAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly([
          "uid",
          "userName",
          "email",
          "referralCode",
          "amount",
          "coinsSnapshot",
          "currency",
          "bankingEnvelope",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.currency == "MXN"
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100
        && exists(/databases/$(database)/documents/user_wallets/$(request.auth.uid))
        && request.resource.data.amount <= get(/databases/$(database)/documents/user_wallets/$(request.auth.uid)).data.coins
        && request.resource.data.coinsSnapshot is int
        && request.resource.data.bankingEnvelope is map
        && request.resource.data.bankingEnvelope.keys().hasOnly(["version", "algorithm", "keyVersion", "wrappedKey", "iv", "ciphertext"])
        && request.resource.data.bankingEnvelope.version == 1
        && request.resource.data.bankingEnvelope.algorithm == "RSA-OAEP-256+A256GCM"
        && request.resource.data.bankingEnvelope.keyVersion is string
        && request.resource.data.bankingEnvelope.wrappedKey is string
        && request.resource.data.bankingEnvelope.wrappedKey.size() <= 1024
        && request.resource.data.bankingEnvelope.iv is string
        && request.resource.data.bankingEnvelope.iv.size() <= 64
        && request.resource.data.bankingEnvelope.ciphertext is string
        && request.resource.data.bankingEnvelope.ciphertext.size() <= 4096
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Las confirmaciones se hacen con Admin SDK local, que no depende de estas reglas.
      allow update, delete: if false;
    }

    match /feedback_submissions/{submissionId} {
      allow read, update, delete: if isAdmin();
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "type",
          "message",
          "createdAt",
          "createdByUid",
          "createdByName",
          "recipientAdminUid",
          "status",
          "source"
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.recipientAdminUid == "admin"
        && request.resource.data.status == "new"
        && request.resource.data.source == "in_app"
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.createdAt is int;
    }

    match /app_ratings/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "stars", "comment", "experienceQualified",
          "answeredAtPrompt", "sessionsAtPrompt", "accountAgeDaysAtPrompt", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.stars in [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && request.resource.data.experienceQualified == true
        && request.resource.data.answeredAtPrompt is int
        && request.resource.data.answeredAtPrompt >= 100
        && request.resource.data.sessionsAtPrompt is int
        && request.resource.data.sessionsAtPrompt >= 3
        && request.resource.data.accountAgeDaysAtPrompt is int
        && request.resource.data.accountAgeDaysAtPrompt >= 7
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isVerifiedSelf(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "stars", "comment", "experienceQualified",
          "answeredAtPrompt", "sessionsAtPrompt", "accountAgeDaysAtPrompt", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.stars in [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && request.resource.data.experienceQualified == true
        && request.resource.data.answeredAtPrompt is int
        && request.resource.data.answeredAtPrompt >= 100
        && request.resource.data.sessionsAtPrompt is int
        && request.resource.data.sessionsAtPrompt >= 3
        && request.resource.data.accountAgeDaysAtPrompt is int
        && request.resource.data.accountAgeDaysAtPrompt >= 7
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if isVerified();
      allow create, update, delete: if isAdmin();
    }

    // Contadores comerciales públicos y sin datos personales.
    match /marketing_counters/{counterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /community_announcements/{announcementId} {
      allow read: if isVerified();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "title",
          "message",
          "createdAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 70
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1200
        && request.resource.data.createdAt is int
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120;
      allow update, delete: if isAdmin();
    }
  }
}
