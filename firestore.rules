rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid in ["sZcIUjjhD0fze7FtirwsjsIDzLB2"];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validReferralCode(code) {
      return code is string && code.matches('^EL[A-Z0-9]{6,12}$');
    }

    function validUserMetricCounters(counters) {
      return counters is map
        && counters.keys().hasAll(["sessions", "answered", "correct", "studySeconds", "pomodoros", "simulations"])
        && counters.keys().hasOnly(["sessions", "answered", "correct", "studySeconds", "pomodoros", "simulations"])
        && counters.sessions is int && counters.sessions >= 0
        && counters.answered is int && counters.answered >= 0
        && counters.correct is int && counters.correct >= 0 && counters.correct <= counters.answered
        && counters.studySeconds is int && counters.studySeconds >= 0
        && counters.pomodoros is int && counters.pomodoros >= 0
        && counters.simulations is int && counters.simulations >= 0;
    }

    function validSpecialtyMetric(row) {
      return row is map
        && row.keys().hasAll(["answered", "correct"])
        && row.keys().hasOnly(["answered", "correct"])
        && row.answered is int && row.answered >= 0
        && row.correct is int && row.correct >= 0 && row.correct <= row.answered;
    }

    function validUserMetrics(data, uid) {
      return data.uid == uid
        && data.schemaVersion == 1
        && data.lastActivityDay is string
        && data.lastActivityDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.activityDays is list && data.activityDays.size() <= 400
        && data.daily is list && data.daily.size() <= 400
        && data.bySpecialty is map
        && data.bySpecialty.keys().hasAll(["mi", "ped", "gyo", "cir"])
        && data.bySpecialty.keys().hasOnly(["mi", "ped", "gyo", "cir"])
        && validSpecialtyMetric(data.bySpecialty.mi)
        && validSpecialtyMetric(data.bySpecialty.ped)
        && validSpecialtyMetric(data.bySpecialty.gyo)
        && validSpecialtyMetric(data.bySpecialty.cir)
        && validUserMetricCounters(data.cumulative)
        && data.features is map
        && data.features.keys().hasOnly(["exams", "studyPlus", "pomodoro", "flashcards", "scales", "community", "referrals"])
        && data.health is map
        && data.health.keys().hasAll(["jsErrors", "pageLoads", "lastPageLoadMs", "lastJsErrorDay"])
        && data.health.keys().hasOnly(["jsErrors", "pageLoads", "lastPageLoadMs", "lastJsErrorDay"])
        && data.health.jsErrors is int && data.health.jsErrors >= 0
        && data.health.pageLoads is int && data.health.pageLoads >= 0
        && data.health.lastPageLoadMs is int && data.health.lastPageLoadMs >= 0
        && data.health.lastJsErrorDay is string
        && (data.health.lastJsErrorDay == "" || data.health.lastJsErrorDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.historyApproximate is bool
        && data.lastActiveAt == request.time
        && data.updatedAt == request.time;
    }

    function hasReferralRedemptionAfter(ownerUid) {
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid)).data.ownerUid == ownerUid
        && getAfter(/databases/$(database)/documents/referral_redemptions/$(request.auth.uid)).data.coins == 50;
    }

    function isReferralRewardUpdate(ownerUid) {
      return request.auth != null
        && request.auth.uid != ownerUid
        && hasReferralRedemptionAfter(ownerUid)
        && request.resource.data.uid == ownerUid
        && request.resource.data.lastReferralUid == request.auth.uid
        && request.resource.data.coins == resource.data.coins + 50;
    }

    function isReferralRewardCreate(ownerUid) {
      return request.auth != null
        && request.auth.uid != ownerUid
        && hasReferralRedemptionAfter(ownerUid)
        && request.resource.data.uid == ownerUid
        && request.resource.data.lastReferralUid == request.auth.uid
        && request.resource.data.coins == 50;
    }

    function isPremiumTrialEntitlement(uid) {
      let trial = getAfter(/databases/$(database)/documents/premium_trials/$(uid));
      return isSelf(uid)
        && trial.data.uid == uid
        && trial.data.status == "used"
        && trial.data.durationDays == 3
        && trial.data.startedAt == request.time
        && request.resource.data.status == "active"
        && request.resource.data.source == "premium_trial"
        && request.resource.data.planId == "premium_trial_3d"
        && request.resource.data.activatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt == trial.data.expiresAt;
    }

    function canReplaceExpiredEntitlementWithTrial() {
      return !resource.data.keys().hasAll(["expiresAt"])
        || resource.data.status != "active"
        || resource.data.expiresAt <= request.time;
    }

    match /redeem_codes/{code} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
        && resource.data.redeemedBy == ""
        && request.resource.data.redeemedBy == request.auth.uid);
    }

    match /entitlements/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin()
        || (request.auth != null
        && request.auth.uid == uid
        && request.resource.data.source == "code"
        && get(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.redeemedBy == request.auth.uid)
        || isPremiumTrialEntitlement(uid);
      allow update: if isAdmin()
        || (request.auth != null
        && request.auth.uid == uid
        && request.resource.data.source == "code"
        && get(/databases/$(database)/documents/redeem_codes/$(request.resource.data.code)).data.redeemedBy == request.auth.uid)
        || (isPremiumTrialEntitlement(uid) && canReplaceExpiredEntitlementWithTrial());
      allow delete: if isAdmin();
    }

    match /payment_profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.transferReference is string
        && request.resource.data.transferReference.matches('^[0-9]{10}$')
        && existsAfter(/databases/$(database)/documents/transfer_references/$(request.resource.data.transferReference))
        && getAfter(/databases/$(database)/documents/transfer_references/$(request.resource.data.transferReference)).data.uid == uid;
      allow update, delete: if false;
    }

    match /transfer_references/{reference} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && reference.matches('^[0-9]{10}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.transferReference == reference
        && existsAfter(/databases/$(database)/documents/payment_profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/payment_profiles/$(request.auth.uid)).data.transferReference == reference;
      allow update, delete: if false;
    }

    match /manual_payment_requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.status == "pending"
        && request.resource.data.currency == "MXN"
        && request.resource.data.termsAccepted == true
        && request.resource.data.referralCode is string
        && request.resource.data.seats is int
        && request.resource.data.squadMembers is list
        && request.resource.data.transferReference == get(/databases/$(database)/documents/payment_profiles/$(request.auth.uid)).data.transferReference
        && ((request.resource.data.planId == "enarm_2026" && request.resource.data.amount == 399 && request.resource.data.seats == 1 && request.resource.data.squadMembers.size() == 0)
          || (request.resource.data.planId == "enarm_2027" && request.resource.data.amount == 1999 && request.resource.data.seats == 1 && request.resource.data.squadMembers.size() == 0)
          || (request.resource.data.planId == "squad_2027" && request.resource.data.amount == 4999 && request.resource.data.seats == 4
            && request.resource.data.squadMembers.size() == 3
            && request.resource.data.squadMembers[0] is string && request.resource.data.squadMembers[0].size() > 0 && request.resource.data.squadMembers[0].size() <= 60
            && request.resource.data.squadMembers[1] is string && request.resource.data.squadMembers[1].size() > 0 && request.resource.data.squadMembers[1].size() <= 60
            && request.resource.data.squadMembers[2] is string && request.resource.data.squadMembers[2].size() > 0 && request.resource.data.squadMembers[2].size() <= 60));
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status in ["pending", "rejected"]
          && request.resource.data.status == "pending"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.planId == resource.data.planId
          && request.resource.data.amount == resource.data.amount
          && (
            (resource.data.keys().hasAll(["seats"]) && request.resource.data.seats == resource.data.seats)
            || (!resource.data.keys().hasAll(["seats"]) && request.resource.data.seats == 1)
          )
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.transferReference == resource.data.transferReference
          && request.resource.data.termsAccepted == true
          && request.resource.data.referralCode is string
          && request.resource.data.squadMembers is list
          && ((request.resource.data.planId in ["enarm_2026", "enarm_2027"] && request.resource.data.squadMembers.size() == 0)
            || (request.resource.data.planId == "squad_2027" && request.resource.data.squadMembers.size() == 3
              && request.resource.data.squadMembers[0] is string && request.resource.data.squadMembers[0].size() > 0 && request.resource.data.squadMembers[0].size() <= 60
              && request.resource.data.squadMembers[1] is string && request.resource.data.squadMembers[1].size() > 0 && request.resource.data.squadMembers[1].size() <= 60
              && request.resource.data.squadMembers[2] is string && request.resource.data.squadMembers[2].size() > 0 && request.resource.data.squadMembers[2].size() <= 60)));
      allow delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isAdmin();
    }

    // Datos de contacto privados para el panel de administraci\u00f3n.
    // No se mezclan con leaderboard, que puede ser le\u00eddo por otros usuarios.
    match /user_directory/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 120
        && request.resource.data.keys().hasOnly(["uid", "email", "username", "createdAt", "lastSeenAt"])
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 120
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["email", "username", "lastSeenAt"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSeenAt"])
          || request.resource.data.lastSeenAt == request.time);
      allow delete: if isAdmin();
    }

    // Una prueba gratuita se crea junto con el entitlement en una transacción.
    // No se puede editar o volver a crear, aun desde un cliente manipulado.
    match /premium_trials/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(["uid", "status", "startedAt", "expiresAt", "durationDays"])
        && request.resource.data.uid == uid
        && request.resource.data.status == "used"
        && request.resource.data.durationDays == 3
        && request.resource.data.startedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, "d") + duration.value(10, "m");
      allow update, delete: if false;
    }

    // Métricas compactas y sin datos personales. El cliente solo mantiene su
    // propio documento; el administrador puede agregarlas en el panel interno.
    match /user_metrics/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll([
          "uid", "schemaVersion", "registeredAt", "trackingStartedAt", "lastActiveAt",
          "lastActivityDay", "activityDays", "cumulative", "bySpecialty", "features", "health",
          "daily", "historyApproximate", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "schemaVersion", "registeredAt", "trackingStartedAt", "lastActiveAt",
          "lastActivityDay", "activityDays", "cumulative", "bySpecialty", "features", "health",
          "daily", "historyApproximate", "updatedAt"
        ])
        && request.resource.data.registeredAt == request.time
        && request.resource.data.trackingStartedAt == request.time
        && validUserMetrics(request.resource.data, uid);
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.registeredAt == resource.data.registeredAt
        && request.resource.data.trackingStartedAt == resource.data.trackingStartedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "schemaVersion", "lastActiveAt", "lastActivityDay", "activityDays", "cumulative",
          "bySpecialty", "features", "health", "daily", "historyApproximate", "updatedAt"
        ])
        && validUserMetrics(request.resource.data, uid);
      allow delete: if isAdmin();
    }

    match /referral_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && validReferralCode(code)
        && request.resource.data.code == code
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /user_wallets/{uid} {
      allow read: if isSignedIn();
      allow create: if (isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.coins == 0
        && validReferralCode(request.resource.data.referralCode))
        || isReferralRewardCreate(uid);
      allow update: if isAdmin() || isReferralRewardUpdate(uid);
      allow delete: if isAdmin();
    }

    match /referral_redemptions/{uid} {
      allow read: if isSelf(uid) || isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.coins == 50
        && validReferralCode(request.resource.data.referralCode)
        && request.resource.data.ownerUid != uid
        && exists(/databases/$(database)/documents/referral_codes/$(request.resource.data.referralCode))
        && get(/databases/$(database)/documents/referral_codes/$(request.resource.data.referralCode)).data.ownerUid == request.resource.data.ownerUid
        && existsAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.premiumCode))
        && getAfter(/databases/$(database)/documents/redeem_codes/$(request.resource.data.premiumCode)).data.redeemedBy == uid;
      allow update, delete: if isAdmin();
    }

    match /withdrawal_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "uid",
          "userName",
          "email",
          "referralCode",
          "amount",
          "coinsSnapshot",
          "currency",
          "fullName",
          "accountHolder",
          "bankName",
          "clabe",
          "phone",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.currency == "MXN"
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100
        && exists(/databases/$(database)/documents/user_wallets/$(request.auth.uid))
        && request.resource.data.amount <= get(/databases/$(database)/documents/user_wallets/$(request.auth.uid)).data.coins
        && request.resource.data.coinsSnapshot is int
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.accountHolder is string
        && request.resource.data.accountHolder.size() >= 3
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() >= 2
        && request.resource.data.clabe is string
        && request.resource.data.clabe.matches('^[0-9]{18}$')
        && request.resource.data.phone is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if isAdmin();
    }

    match /feedback_submissions/{submissionId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "type",
          "message",
          "createdAt",
          "createdByUid",
          "createdByName",
          "recipientAdminUid",
          "status",
          "source"
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.recipientAdminUid == "sZcIUjjhD0fze7FtirwsjsIDzLB2"
        && request.resource.data.status == "new"
        && request.resource.data.source == "in_app"
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.createdAt is int;
    }

    match /app_ratings/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "stars", "comment", "experienceQualified",
          "answeredAtPrompt", "sessionsAtPrompt", "accountAgeDaysAtPrompt", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.stars in [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && request.resource.data.experienceQualified == true
        && request.resource.data.answeredAtPrompt is int
        && request.resource.data.answeredAtPrompt >= 100
        && request.resource.data.sessionsAtPrompt is int
        && request.resource.data.sessionsAtPrompt >= 3
        && request.resource.data.accountAgeDaysAtPrompt is int
        && request.resource.data.accountAgeDaysAtPrompt >= 7
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "stars", "comment", "experienceQualified",
          "answeredAtPrompt", "sessionsAtPrompt", "accountAgeDaysAtPrompt", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.stars in [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 800
        && request.resource.data.experienceQualified == true
        && request.resource.data.answeredAtPrompt is int
        && request.resource.data.answeredAtPrompt >= 100
        && request.resource.data.sessionsAtPrompt is int
        && request.resource.data.sessionsAtPrompt >= 3
        && request.resource.data.accountAgeDaysAtPrompt is int
        && request.resource.data.accountAgeDaysAtPrompt >= 7
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Contadores comerciales públicos y sin datos personales.
    match /marketing_counters/{counterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /community_announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "title",
          "message",
          "createdAt",
          "createdBy",
          "createdByName"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 70
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1200
        && request.resource.data.createdAt is int
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120;
      allow update, delete: if isAdmin();
    }
  }
}
